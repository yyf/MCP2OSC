{
  "name": "mcp2osc-demo",
  "version": 1,
  "description": "Shared minimal demo: slider, button toggle, preset load",
  "ports": {
    "mcp2osc_send": 9500,
    "mcp2osc_receive": 9501,
    "host": "127.0.0.1"
  },
  "addresses": [
    {
      "address": "/mcp2osc/demo/slider",
      "type": "f",
      "range": [0, 1],
      "default": 0.5,
      "interaction": "slider",
      "description": "Continuous knob/slider parameter"
    },
    {
      "address": "/mcp2osc/demo/button",
      "type": "i",
      "range": [0, 1],
      "default": 0,
      "interaction": "toggle",
      "description": "Button toggle (0=off, 1=on)"
    },
    {
      "address": "/mcp2osc/demo/preset",
      "type": "i",
      "range": [1, 3],
      "default": 1,
      "interaction": "preset",
      "description": "Load preset index 1, 2, or 3"
    }
  ],
  "presets": {
    "1": { "slider": 0.25, "button": 0, "label": "soft" },
    "2": { "slider": 0.5, "button": 1, "label": "mid" },
    "3": { "slider": 1.0, "button": 1, "label": "full" }
  }
}
