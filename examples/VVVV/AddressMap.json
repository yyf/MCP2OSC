{
  "app": "VVVV",
  "listenPort": 9500,
  "protocol": "UDP",
  "addresses": [
    {
      "address": "/mcp2osc/demo/slider",
      "type": "f",
      "range": [0, 1],
      "interaction": "slider",
      "hint": "OSCReceiver → Float32 → Transform / Color / FX amount"
    },
    {
      "address": "/mcp2osc/demo/button",
      "type": "i",
      "range": [0, 1],
      "interaction": "toggle",
      "hint": "OSCReceiver → Integer32 → Switch / Enable / visibility"
    },
    {
      "address": "/mcp2osc/demo/preset",
      "type": "i",
      "range": [1, 3],
      "interaction": "preset",
      "hint": "OSCReceiver → Integer32 → Select / Switch for presets 1–3"
    }
  ],
  "presets": {
    "1": { "slider": 0.25, "button": 0, "label": "soft" },
    "2": { "slider": 0.5, "button": 1, "label": "mid" },
    "3": { "slider": 1.0, "button": 1, "label": "full" }
  }
}
