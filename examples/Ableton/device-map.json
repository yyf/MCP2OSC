{
  "app": "AbletonLive",
  "requires": "Max for Live",
  "listenPort": 9500,
  "controls": [
    {
      "address": "/mcp2osc/demo/slider",
      "type": "f",
      "ui": "live.dial",
      "interaction": "slider"
    },
    {
      "address": "/mcp2osc/demo/button",
      "type": "i",
      "ui": "live.toggle",
      "interaction": "toggle"
    },
    {
      "address": "/mcp2osc/demo/preset",
      "type": "i",
      "ui": "message packs 1|2|3",
      "interaction": "preset",
      "presets": {
        "1": { "slider": 0.25, "button": 0 },
        "2": { "slider": 0.5, "button": 1 },
        "3": { "slider": 1.0, "button": 1 }
      }
    }
  ]
}
