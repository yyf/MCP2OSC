{
  "name": "mcp2osc-touchdesigner-demo",
  "port": 9500,
  "protocol": "UDP",
  "addresses": [
    {
      "address": "/mcp2osc/demo/slider",
      "type": "f",
      "range": [0, 1],
      "wire_to": "OSC In CHOP channel → Math/Level/Color"
    },
    {
      "address": "/mcp2osc/demo/button",
      "type": "i",
      "range": [0, 1],
      "wire_to": "Switch / visibility / bypass"
    },
    {
      "address": "/mcp2osc/demo/preset",
      "type": "i",
      "range": [1, 3],
      "wire_to": "Select CHOP or Script DAT for presets 1–3"
    }
  ],
  "presets": {
    "1": { "slider": 0.25, "button": 0, "label": "soft" },
    "2": { "slider": 0.5, "button": 1, "label": "mid" },
    "3": { "slider": 1.0, "button": 1, "label": "full" }
  }
}
