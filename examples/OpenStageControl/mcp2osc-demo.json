{
  "createdWith": "Open Stage Control",
  "version": "1.0.0",
  "type": "session",
  "comment": "MCP2OSC demo — fader, toggle, preset buttons. Adjust osc targets for your OSC version if needed.",
  "osc": {
    "host": "127.0.0.1",
    "port": 9500
  },
  "session": {
    "widgets": [
      {
        "type": "fader",
        "id": "mcp2osc_slider",
        "label": "Slider",
        "top": 40,
        "left": 40,
        "width": 60,
        "height": 220,
        "range": [0, 1],
        "address": "/mcp2osc/demo/slider",
        "preArgs": [],
        "target": "127.0.0.1:9500"
      },
      {
        "type": "toggle",
        "id": "mcp2osc_button",
        "label": "Button",
        "top": 40,
        "left": 140,
        "width": 80,
        "height": 80,
        "address": "/mcp2osc/demo/button",
        "on": 1,
        "off": 0,
        "target": "127.0.0.1:9500"
      },
      {
        "type": "button",
        "id": "mcp2osc_preset1",
        "label": "Preset 1",
        "top": 140,
        "left": 140,
        "width": 100,
        "height": 40,
        "address": "/mcp2osc/demo/preset",
