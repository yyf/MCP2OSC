        "target": "127.0.0.1:9500"
      },
      {
        "type": "button",
        "id": "mcp2osc_preset2",
        "label": "Preset 2",
        "top": 190,
        "left": 140,
        "width": 100,
        "height": 40,
        "address": "/mcp2osc/demo/preset",
        "preArgs": [2],
        "target": "127.0.0.1:9500"
      },
      {
        "type": "button",
        "id": "mcp2osc_preset3",
        "label": "Preset 3",
        "top": 240,
        "left": 140,
        "width": 100,
        "height": 40,
        "address": "/mcp2osc/demo/preset",
        "preArgs": [3],
        "target": "127.0.0.1:9500"
      }
    ]
  }
}
